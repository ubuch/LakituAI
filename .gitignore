# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test, lint, and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Local config and secrets
.env
.env.*
!.env.example

# User-specific config (not version controlled)
config/current_war.json
config/players.json
config/team_tags.json
config/settings.json

# Notebooks
.ipynb_checkpoints/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
# Windows NTFS zone metadata (generated when files are downloaded/transferred)
*:Zone.Identifier

# Local scratch/output folders
tmp/
temp/
outputs/

# Resources (generated/user input, not version controlled)
resources/results
resources/rows
resources/scoreboards
resources/screenshots
resources/wars.db
